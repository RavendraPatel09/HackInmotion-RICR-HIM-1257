########################################
# SMARTCITY RESOLVE - AI VERIFICATION SERVICE
########################################

ENV=development
PORT=8000

# Must match AI_SERVICE_API_KEY in the NestJS Admin API's .env
# Every request must send this in the X-API-Key header.
AI_SERVICE_API_KEY=replace-with-internal-service-key

# Comma-separated list of allowed origins (the Admin API, internal only)
CORS_ORIGIN=http://localhost:5173

# Model version tag returned in every response for audit trail purposes
MODEL_VERSION=rule-engine-v1.0.0

# HTTP timeout (seconds) when fetching remote images for hashing
IMAGE_FETCH_TIMEOUT=10
